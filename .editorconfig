root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# The inspection contract: warning severity and above must stay at zero
# (ci.yml inspect job), and suggestion-level findings are either taken or
# scoped off here with the reason. Deliberate rejections:
# - World.cs: '??=' on the byte* field does not compile (CS0019), so the
#   explicit null check stays. (050c199)
# - World.cs: Move's early-out compares floats by == on purpose — it must
#   skip only a bitwise-unchanged position, and Equals would flip NaN and
#   -0.0. (075ce60)
# - SenseVerification.cs: sensing receipts compare world positions and
#   gradients by == on purpose — the oracle reproduces the engine's float ops
#   exactly, so anything but bit equality is a failed receipt.
# - Stamp.cs: Stamp.New(sbyte*) is public API for unmanaged callers even
#   though nothing in-repo calls it. (050c199)
# - ResolvePool.cs: WorkerLoop parks in a process-lifetime loop by design —
#   pool workers are background threads that never terminate. (#20)
# - SkipLocalsInitAttribute.cs: the netstandard2.1 polyfill must be declared in
#   System.Runtime.CompilerServices — the compiler honors the attribute by its
#   full name only.
# - LayerVerification.cs, ShapeVerification.cs, TimeVerification.cs: receipts
#   compare gradients and world positions by == on purpose, like
#   SenseVerification.cs — the engine must match its oracle bit for bit.
[benchmarks/SenseVerification.cs]
resharper_compare_of_floats_by_equality_operator_highlighting = none

[benchmarks/LayerVerification.cs]
resharper_compare_of_floats_by_equality_operator_highlighting = none

[benchmarks/ShapeVerification.cs]
resharper_compare_of_floats_by_equality_operator_highlighting = none

[benchmarks/TimeVerification.cs]
resharper_compare_of_floats_by_equality_operator_highlighting = none

[src/Gi/SkipLocalsInitAttribute.cs]
resharper_check_namespace_highlighting = none

[src/Gi/World.cs]
resharper_convert_if_statement_to_null_coalescing_assignment_highlighting = none
resharper_compare_of_floats_by_equality_operator_highlighting = none

[src/Gi/Stamp.cs]
resharper_unused_member_global_highlighting = none

[src/Gi/ResolvePool.cs]
resharper_function_never_returns_highlighting = none

[*.{csproj,props,targets,slnx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
