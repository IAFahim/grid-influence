<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(GiVersion)</Version>
    <PackageId>Gi.Io</PackageId>
    <Authors>IAFahim</Authors>
    <Description>PNM/PPM weight-map codec and JSON scene runner for Gi. Import, export, and file-driven simulation separate from the engine.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/gi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/gi</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pack-readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gi\Gi.csproj" />
  </ItemGroup>

</Project>
